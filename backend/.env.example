# Variables de entorno para sistema de suscripciones

# MongoDB
MONGODB_URI=tu_mongodb_uri

# Puerto del servidor
PORT=3001

# JWT Secret
JWT_SECRET=tu_jwt_secret

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=TEST-16442878685322-010321-a6d0528f72696cdbfa47826c05ab6d6e-220623831
# Para testing usar: TEST-xxxx-xxxxxx-xxxxxx-xxxxxx
# Para producción usar: APP-xxxx-xxxxxx-xxxxxx-xxxxxx

# Configuración de MercadoPago
# Obtén tus credenciales en: https://www.mercadopago.cl/developers/panel/credentials
# 1. Crea una aplicación en el panel de desarrolladores
# 2. Copia el Access Token (para testing usa el de prueba)
# 3. Configura las URLs de notificación en tu panel

# IMPORTANTE: Las URLs de webhook deben ser públicas
# Para desarrollo local, usa ngrok o similar:
# ngrok http 3001
# Y configura BACKEND_URL con la URL pública de ngrok
